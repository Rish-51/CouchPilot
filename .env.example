# CouchPilot Environment Configuration

# Service mode: web | worker | cli
COUCHPILOT_MODE=cli

# Dashboard API Settings
COUCHPILOT_DASHBOARD_URL=http://localhost:8000
COUCHPILOT_API_KEY=couchpilot_secret_key_change_me_in_prod

# Persistence
DATABASE_URL=sqlite+aiosqlite:///data/couchpilot.db

# LLM Provider Configuration (OpenAI Compatible)
# Presets:
# Groq: https://api.groq.com/openai/v1 (model: gemma2-9b-it)
# Google AI Studio: https://generativelanguage.googleapis.com/v1beta/openai/ (model: gemma-2-9b-it)
# Ollama: http://localhost:11434/v1 (model: gemma2:2b)
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=your_groq_or_provider_api_key_here
LLM_MODEL_ID=gemma2-9b-it
LLM_FALLBACK_MODEL_ID=gemma-2-9b-it

# Temporal Orchestration Settings (Local Dev Server)
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=couchpilot-task-queue

# Observability (Optional: Leave empty for silent no-op)
SENTRY_DSN=

# Demo Configuration
# Options: replay | live
DEMO_MODE=replay
